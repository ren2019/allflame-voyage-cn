{
  "name": "allflame-voyage-cn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prototype:strategy": "vite --host 127.0.0.1 --port 4191 --strictPort --open '/?prototype=strategy&variant=A'",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && npm run test:border-ocr",
    "test:border-ocr": "node tests/border-ocr-regression.cjs",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "site:init": "node scripts/local-site.mjs init",
    "site:start": "node scripts/local-site.mjs start",
    "site:stop": "node scripts/local-site.mjs stop",
    "site:status": "node scripts/local-site.mjs status",
    "site:update": "node scripts/local-site.mjs update",
    "test:deployment": "node --test tests/deployment/local-site.test.mjs",
    "test:https": "node tests/deployment/verify-browser.mjs",
    "test:windows": "node tests/deployment/verify-windows-edge.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.6"
  }
}
